# NVIDIA API key for embeddings and the RAG LLM
NVIDIA_API_KEY=your_nvidia_api_key_here

# Vector store persistence directory
CHROMA_PERSIST_DIRECTORY=./chroma_db

# SQLite metadata database
SQLITE_DB_PATH=./data/metadata.db

# Language model used for grounded answer generation
LLM_MODEL=nvidia/nemotron-3-nano-30b-a3b

# Embedding model used to index & retrieve chunks (keep consistent with ingest)
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# Retrieval strategy
SEARCH_TYPE=mmr
FETCH_K=20
LAMBDA_MULT=0.7

# --- Optional overrides (defaults shown) ---------------------------------------
# DOCS_CORPUS_URL=https://docs.langchain.com/oss/python/llms-full.txt
# EMBEDDING_BATCH_SIZE=64
# CHROMA_COLLECTION_NAME=langchain_docs
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# TOP_K=8
# LLM_TEMPERATURE=0.1
# MAX_HISTORY_TURNS=6
# EVAL_JUDGE_MODEL=nvidia/nemotron-3-super-120b-a12b